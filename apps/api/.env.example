MEDARCHIVE_ENVIRONMENT=dev
MEDARCHIVE_DATABASE_URL=sqlite+aiosqlite:///./medarchive.db
MEDARCHIVE_JWT_SECRET=change-me-in-production
MEDARCHIVE_ACCESS_TOKEN_TTL_MINUTES=15
MEDARCHIVE_REFRESH_TOKEN_TTL_DAYS=30
MEDARCHIVE_MAIL_DOMAIN=in.medarchive.local
MEDARCHIVE_STORAGE_BACKEND=local
MEDARCHIVE_STORAGE_ROOT=./.data
MEDARCHIVE_AUTO_CREATE_TABLES=true
MEDARCHIVE_SMTP_HOST=127.0.0.1
MEDARCHIVE_SMTP_PORT=8025

# Ключ шифрования паролей IMAP. Если не задан, выводится из JWT_SECRET.
# В production задать отдельно и не менять после подключения ящиков.
# MEDARCHIVE_SECRET_ENCRYPTION_KEY=change-me-stable-key
MEDARCHIVE_IMAP_SYNC_LIMIT=50
MEDARCHIVE_IMAP_TIMEOUT_SECONDS=20

# S3 / MinIO (production)
# MEDARCHIVE_STORAGE_BACKEND=s3
# MEDARCHIVE_S3_ENDPOINT=http://minio:9000
# MEDARCHIVE_S3_BUCKET=medarchive
# MEDARCHIVE_S3_ACCESS_KEY=minioadmin
# MEDARCHIVE_S3_SECRET_KEY=minioadmin
# MEDARCHIVE_S3_REGION=ru-central1
